{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "types": [
      "node"
    ],
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/node"
  },
  "include": [
    "vite.config.ts"
  ]
}
